# ============================================================
# Frontend Environment Variables – SBT Certificate System
# Copy to .env and fill in real values. DO NOT commit .env
# ============================================================

# ── Vite Public Variables (accessible in browser) ───────────
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Ethereum network configuration
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Optional explorer; defaults to Sepolia Etherscan, omitted for Hardhat Local.
# VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
# For local development, replace the values above with:
# VITE_CHAIN_ID=31337
# VITE_CHAIN_NAME=Hardhat Local
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_BLOCK_EXPLORER_URL=

# Deployed SBT Smart Contract address (fill after deployment)
VITE_SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS Gateway for reading metadata
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# App settings
VITE_APP_NAME=SBT Certificate System
VITE_APP_ENV=development
