# ============================================================
# Backend Environment Variables – SBT Certificate System
# Copy to .env and fill in real values. DO NOT commit .env
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=SBT Certificate System API
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sbt_certificates.db

# ── Ethereum / Web3 ──────────────────────────────────────────
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Optional Alchemy fallback
# WEB3_PROVIDER_URL_ALT=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

CHAIN_ID=11155111

# Smart Contract (fill after deployment)
SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Admin wallet (backend signer for minting – keep PRIVATE KEY secret!)
# Use a dedicated hot wallet with minimal funds for minting only
ADMIN_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
ADMIN_PRIVATE_KEY=NEVER_COMMIT_YOUR_ACTUAL_PRIVATE_KEY

# ── IPFS / Pinning ───────────────────────────────────────────
# Supported services: pinata | web3storage | local
IPFS_PINNING_SERVICE=pinata
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_API_KEY=YOUR_PINATA_SECRET_API_KEY
# Web3.Storage (alternative)
WEB3STORAGE_TOKEN=YOUR_WEB3STORAGE_TOKEN
# Public IPFS gateway for reads
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── JWT Authentication ───────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
