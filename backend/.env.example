# Copy to .env and generate a fresh SECRET_KEY:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_NAME=SBT Certificate System API
APP_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Explicit frontend origins, comma separated. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
# Default database: backend/sbt_certificates.db, independent of working directory.
# DATABASE_URL=sqlite:///./sbt_certificates.db
# Optional: required only for confirmation/live verification.
WEB3_PROVIDER_URL=
CHAIN_ID=11155111
SBT_CONTRACT_ADDRESS=
MIN_CONFIRMATIONS=2
# Optional: real Pinata upload returns 503 until configured.
PINATA_JWT=
MAX_CSV_BYTES=1048576
MAX_CSV_ROWS=1000
