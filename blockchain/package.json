{
  "name": "sbt-certificate-blockchain",
  "version": "1.0.0",
  "description": "Smart contracts for SBT Certificate System – Soulbound Token on Ethereum Sepolia",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:integration": "node scripts/test-backend.js",
    "deploy:ephemeral": "hardhat run scripts/deploy.js --network hardhat",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "preflight:sepolia": "hardhat run scripts/preflight-sepolia.js --network sepolia",
    "check:sepolia": "hardhat run scripts/check-sepolia.js --network sepolia",
    "smoke:sepolia": "hardhat run scripts/smoke-sepolia.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.js --network sepolia",
    "verify": "hardhat verify --network sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "export-abi": "node scripts/exportAbi.js",
    "lint": "solhint --disc \"contracts/**/*.sol\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.4",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.2",
    "solc": "0.8.28",
    "solhint": "^5.0.3",
    "solidity-coverage": "0.8.17"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "serialize-javascript": "7.1.3"
  }
}
