# Environment variables for local tooling. Never put keys in source code.
# Local Hardhat node/test needs no key or RPC configuration.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Defaults to the deployer; use a controlled admin wallet or multisig.
INITIAL_ADMIN_ADDRESS=
# Optional explicit grant at deployment; requires deployer == initial admin.
INITIAL_ORGANIZER_ADDRESS=
# Optional ABI export metadata (does not deploy).
SBT_CONTRACT_ADDRESS=
