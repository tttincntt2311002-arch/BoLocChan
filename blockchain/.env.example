# ============================================================
# Blockchain Environment Variables – SBT Certificate System
# Copy to .env and fill in real values. DO NOT commit .env
# ============================================================

# ── Hardhat Network ──────────────────────────────────────────
# Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Optional Alchemy
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer Wallet ──────────────────────────────────────────
# This is the wallet that pays deployment gas – use a testnet wallet only
DEPLOYER_PRIVATE_KEY=NEVER_COMMIT_YOUR_ACTUAL_PRIVATE_KEY
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Contract Verification ────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Deployment Info (auto-filled by deploy script) ───────────
# SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
