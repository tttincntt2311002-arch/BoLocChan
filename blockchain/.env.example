# Environment variables for local tooling. Never put keys in source code.
# Local Hardhat node/test needs no key or RPC configuration.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Defaults to the deployer; use a controlled admin wallet or multisig.
INITIAL_ADMIN_ADDRESS=
# Optional explicit grant at deployment; requires deployer == initial admin.
INITIAL_ORGANIZER_ADDRESS=
# Optional ABI export metadata (does not deploy).
SBT_CONTRACT_ADDRESS=
# Per-transaction maximum gas budget in Sepolia ETH, not a requested deposit.
MAX_TRANSACTION_COST_ETH=0.02
SEPOLIA_CONFIRMATIONS=2
# Smoke test grants Organizer to the configured deployer and mints one test token.
# Leave recipient blank to receive it in the same dedicated test wallet.
SMOKE_RECIPIENT_ADDRESS=
# Leave blank for real, self-contained data:application/json metadata.
SMOKE_METADATA_URI=
